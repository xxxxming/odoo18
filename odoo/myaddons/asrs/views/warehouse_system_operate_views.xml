<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="warehouse_system_operate_view_list" model="ir.ui.view">
        <field name="name">warehouse_system_operate_view_list</field>
        <field name="model">warehouse.system.operate</field>
        <field name="arch" type="xml">
            <list>
                <field name="workshop"/>
                <field name="line"/>
                <field name="machine"/>

                <field name="emergency_stop"/>
                <field name="manual_auto_control"/>

            </list>
        </field>
    </record>
    <record id="warehouse_system_operate_view_form" model="ir.ui.view">
        <field name="name">warehouse_system_operate_view_form</field>
        <field name="model">warehouse.system.operate</field>
        <field name="arch" type="xml">
            <form js_class="warehouse_form">

                <header>
                    <button name="emergency_button" type="object" string="急停按钮" class="btn-danger"
                            invisible="emergency_stop != True"/>
                    <button name="emergency_button" type="object" string="急停按钮" class="btn-secondary"
                            invisible="emergency_stop == True"/>

<!--                    <button name="manual_auto_button" type="object" string="手动模式"/>-->
<!--                    <button name="start_button" type="object" string="启动按钮"/>-->
<!--                    <button name="stop_button" type="object" string="停止按钮"/>-->
<!--                    <button name="pause_button" type="object" string="暂停按钮"/>-->

                    <button name="pause_button" type="object" string="暂停按钮" class="btn-warning"
                            invisible="pause != True"/>
                    <button name="pause_button" type="object" string="暂停按钮" class="btn-secondary"
                            invisible="pause == True"/>

<!--                    <button name="reset_button" type="object" string="复位按钮"/>-->
                    <button name="reload_data_button" type="object" string="刷新按钮"/>

<!--                    <button name="test_button" type="object" string="测试按钮"/>-->

                    <field name="status" widget="statusbar"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <group>
                                <field name="workshop" readonly="True"/>
                                <field name="line" readonly="True"/>
                                <field name="machine" readonly="True"/>
                                <field name="current_user_name" readonly="True"/>
                            </group>
                            <group>
                                <field name="pack_number"  style="background-color:#d4edda; width: 140px;"/>
                                <field name="pack_barcode" style="width:140px;"/>
                                <field name="location_number" style="width:140px;"/>
                                <field name="netcontrol"  readonly="True"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="entrance" style="background-color: #e6e6fa;width: 140px;"/>
                                <field name="source_target" style="width:140px;"/>
                                <field name="new_target" style="width:140px;"/>
                                <field name="auto_ready" readonly="True"/>
                            </group>
                            <group>
                                <newline/>
                                <group>
                                    <field name="allow_move_stock" readonly="True"/>
                                </group>
                                <group>
<!--                                    <button name="move_stock_button" type="object" string="执行移库"-->
<!--                                            class="btn-info"/>-->
                                    <button name="move_stock_button" type="object" string="执行移库" class="btn-success"
                                            invisible="move_stock != True"/>
                                    <button name="move_stock_button" type="object" string="执行移库" class="btn-secondary"
                                            invisible="move_stock == True"/>
                                </group>
                                <newline/>
                                    <group>
                                        <field name="allow_store" readonly="True"/>
                                    </group>
                                <group>
<!--                                    <button name="store_button" type="object" string="执行入库"-->
<!--                                            class="btn-info"/>-->
                                    <button name="store_button" type="object" string="执行入库" class="btn-success"
                                            invisible="store != True"/>
                                    <button name="store_button" type="object" string="执行入库" class="btn-secondary"
                                            invisible="store == True"/>
                                </group>
                                <newline/>
                                <group>
                                    <field name="allow_outbound" readonly="True"/>
                                </group>
                                <group>
<!--                                    <button name="outbound_button" type="object" string="执行出库"-->
<!--                                            class="btn-info"/>-->
                                    <button name="outbound_button" type="object" string="执行出库" class="btn-success"
                                            invisible="outbound != True"/>
                                    <button name="outbound_button" type="object" string="执行出库" class="btn-secondary"
                                            invisible="outbound == True"/>
                                </group>
                                <newline/>
                                <group>
                                    <field name="allow_return" readonly="True"/>
                                </group>
                                <group>
<!--                                    <button name="return_store_button" type="object" string="执行返库"-->
<!--                                            class="btn-info"/>-->
                                    <button name="return_store_button" type="object" string="执行返库" class="btn-success"
                                            invisible="return_store != True"/>
                                    <button name="return_store_button" type="object" string="执行返库" class="btn-secondary"
                                            invisible="return_store == True"/>
                                </group>
                            </group>
                        </group>
                    </group>
                    <notebook>
                        <page string="货物信息流">
                            <group col="5">
                                <group string="存储区">
                                    <field name="storage_goods_status"/>
                                    <field name="storage_goods_cancel"/>
                                    <field name="storage_pack_number" style="width:80px;"/>
                                    <field name="storage_location_number" style="width:80px;"/>
                                    <field name="storage_pack_barcode" style="width:80px;"/>
                                </group>
                                <group string="堆垛机">
                                    <field name="stacker_goods_status"/>
                                    <field name="stacker_goods_cancel"/>
                                    <field name="stacker_pack_number" style="width:80px;"/>
                                    <field name="stacker_location_number" style="width:80px;"/>
                                    <field name="stacker_pack_barcode" style="width:100px;"/>
                                </group>
                                <group string="出入口1(20101)">
                                    <field name="entrance1_goods_status"/>
                                    <field name="entrance1_goods_cancel"/>
                                    <field name="entrance1_pack_number" style="width:80px;"/>
                                    <field name="entrance1_location_number" style="width:80px;"/>
                                    <field name="entrance1_pack_barcode" style="width:80px;"/>
                                </group>
                                <group string="出入口2(20102)">
                                    <field name="entrance2_goods_status"/>
                                    <field name="entrance2_goods_cancel"/>
                                    <field name="entrance2_pack_number" style="width:80px;"/>
                                    <field name="entrance2_location_number" style="width:80px;"/>
                                    <field name="entrance2_pack_barcode" style="width:80px;"/>
                                </group>
                                <group string="移库">
                                    <field name="move_store_goods_status"/>
                                    <field name="move_store_goods_cancel"/>
                                    <field name="move_store_pack_number" style="width:80px;"/>
                                    <field name="move_store_location_number" style="width:80px;"/>
                                    <field name="move_store_pack_barcode" style="width:80px;"/>
                                </group>
                            </group>
                        </page>

                        <page string="操作日志">
<!--                                <button name="clear_logs" type="object" string="Clear Logs" class="btn-secondary mt8"/>-->
<!--                                <field name="log_messages" widget="ace" options="{'mode': 'text'}" placeholder="Operation logs will appear here..." style="min-height: 300px;"/>-->
<!--                                <div style="display: flex; flex-direction: row; gap: 10px;">-->
<!--                                    <div style="flex: 1;">-->
<!--                                        <field name="log_messages" widget="ace" options="{'mode': 'text'}"-->
<!--                                               placeholder="Operation logs will appear here..." style="min-height: 300px;"/>-->
<!--                                    </div>-->
<!--                                    <div style="flex: 1;">-->
<!--                                        <field name="log_messages" widget="ace" options="{'mode': 'text'}"-->
<!--                                               placeholder="Operation logs will appear here..." style="min-height: 300px;"/>-->
<!--                                    </div>-->
<!--                                </div>-->
                                <div style="display: flex; flex-direction: column; gap: 10px;">
                                    <div style="display: flex; flex-direction: row; gap: 10px;">
                                        <div style="flex: 1;">
                                            <label for="first_30_logs" string="前30条日志记录"/>
                                            <field name="first_30_logs" widget="ace" options="{'mode': 'text'}"
                                                   placeholder="First 30 operation logs will appear here..." style="min-height: 300px;"/>
                                        </div>
                                        <div style="flex: 1;">
                                            <label for="last_30_logs" string="后30条日志记录"/>
                                            <field name="last_30_logs" widget="ace" options="{'mode': 'text'}"
                                                   placeholder="Last 30 operation logs will appear here..." style="min-height: 300px;"/>
                                        </div>
                                    </div>
<!--                                    <div>-->
<!--                                        <label for="log_messages" string="完整日志记录"/>-->
<!--                                        <field name="log_messages" widget="ace" options="{'mode': 'text'}"-->
<!--                                               placeholder="All operation logs will appear here..." style="min-height: 200px;"/>-->
<!--                                    </div>-->
                                </div>
                        </page>
                    </notebook>
                </sheet>
            </form>

        </field>
    </record>


    <record id="warehouse_system_operate_act_window" model="ir.actions.act_window">
        <field name="name">立库操作</field>
        <field name="res_model">warehouse.system.operate</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
