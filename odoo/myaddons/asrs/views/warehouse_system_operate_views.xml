<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="warehouse_system_operate_view_list" model="ir.ui.view">
        <field name="name">warehouse_system_operate_view_list</field>
        <field name="model">warehouse.system.operate</field>
        <field name="arch" type="xml">
            <list>
                <field name="workshop"/>
                <field name="line"/>
                <field name="machine"/>

                <field name="emergency_stop"/>
                <field name="manual_auto_control"/>

            </list>
        </field>
    </record>
    <record id="warehouse_system_operate_view_form" model="ir.ui.view">
        <field name="name">warehouse_system_operate_view_form</field>
        <field name="model">warehouse.system.operate</field>
        <field name="arch" type="xml">
            <form js_class="warehouse_form">
<!--            <form string="立库操作">-->
                <header>
                    <button name="emergency_button" type="object" string="急停按钮"/>
<!--                    <button name="manual_auto_button" type="object" string="手动模式"/>-->
<!--                    <button name="start_button" type="object" string="启动按钮"/>-->
                    <button name="stop_button" type="object" string="停止按钮"/>
                    <button name="pause_button" type="object" string="暂停按钮"/>
                    <button name="reset_button" type="object" string="复位按钮"/>

                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <group>
                                <field name="workshop" readonly="True"/>
                                <field name="line" readonly="True"/>
                                <field name="machine" readonly="True"/>
                            </group>
                            <group>
                                <field name="pack_number"  style="background-color: #d4edda;"/>
                                <field name="pack_barcode" widget="RefreshStorageFields"/>
                                <field name="location_number"  widget="RefreshStorageFields"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="entrance"/>
                                <field name="source_target"  widget="RefreshStorageFields"/>
                                <field name="new_target"  widget="custom_selector"/>
                            </group>
                            <group>
                                <newline/>
                                <group>
                                    <field name="allow_move_stock" readonly="True" widget="RefreshStorageFields"/>
                                </group>
                                <group>
                                    <button name="move_stock_button" type="object" string="执行移库"
                                            class="btn-info"/>
                                </group>
                                <newline/>
                                    <group>
                                        <field name="allow_store" readonly="True" widget="RefreshStorageFields"/>
                                    </group>
                                <group>
                                    <button name="store_button" type="object" string="执行入库"
                                            class="btn-info"/>
                                </group>
                                <newline/>
                                <group>
                                    <field name="allow_outbound" readonly="True" widget="RefreshStorageFields"/>
                                </group>
                                <group>
                                    <button name="outbound_button" type="object" string="执行出库"
                                            class="btn-info"/>
                                </group>
                                <newline/>
                                <group>
                                    <field name="allow_return" readonly="True" widget="RefreshStorageFields"/>
                                </group>
                                <group>
                                    <button name="return_store_button" type="object" string="执行返库"
                                            class="btn-info"/>
                                </group>
                            </group>
                        </group>
                    </group>
                    <notebook>
                        <page string="出入库">

                            <form>
                                <group col="3">
<!--                                    <header>-->
<!--                                        <button name="storage_information_write" type="object" string="库位写入"/>-->
<!--                                        <button name="storage_information_read" type="object" string="库位读取"/>-->
<!--                                        <button name="compare_pack_barcode" type="object" string="查询框号"/>-->

<!--                                    </header>-->
<!--                                    <newline/>-->
                                    <group string="库位信息">
                                        <group>
                                            <field name="storage_goods_status"/>
                                            <field name="storage_goods_cancel"/>
                                        </group>
                                        <group>
                                            <group >
                                                <field name="storage_pack_number" style="width:100px;"/>
<!--                                                <field name="storage_base_number" />-->
                                                <field name="storage_location_number" style="width:100px;"/>
                                                <field name="storage_pack_barcode" style="width:100px;"/>
                                            </group>
                                        </group>
                                    </group>
                                    <group string="堆高机">
                                        <group>
                                            <field name="stacker_goods_status"/>
                                            <field name="stacker_goods_cancel"/>
                                        </group>
                                        <group>
                                            <group>
                                                <field name="stacker_pack_number" style="width:100px;"/>
<!--                                                <field name="stacker_base_number"/>-->
                                                <field name="stacker_location_number" style="width:100px;"/>
                                                <field name="stacker_pack_barcode" style="width:100px;"/>
                                            </group>
                                            >
                                        </group>
                                    </group>
                                    <group string="堆高机">
                                        <group>
                                            <field name="stacker_goods_status"/>
                                            <field name="stacker_goods_cancel"/>
                                        </group>

                                        <group>
                                            <group>
                                                <field name="stacker_pack_number" style="width:100px;"/>
<!--                                                <field name="stacker_base_number"/>-->
                                                <field name="stacker_location_number" style="width:100px;"/>
                                                <field name="stacker_pack_barcode" style="width:100px;"/>
                                            </group>
                                            >
                                        </group>
                                    </group>
                                    <newline/>
                                    <group string="出入口1">
                                        <group>
                                            <field name="entrance1_goods_status"/>
                                            <field name="entrance1_goods_cancel"/>
                                        </group>
                                        <group>
                                            <group>
                                                <field name="entrance1_pack_number" style="width:100px;"/>
<!--                                                <field name="entrance1_base_number"/>-->
                                                <field name="entrance1_location_number" style="width:100px;"/>
                                                <field name="entrance1_pack_barcode" style="width:100px;"/>
                                            </group>
                                            >
                                        </group>
                                    </group>
                                    <group string="出入口2">
                                        <group>
                                            <field name="entrance2_goods_status"/>
                                            <field name="entrance2_goods_cancel"/>
                                        </group>
                                        <group>
                                            <group>
                                                <field name="entrance2_pack_number" style="width:100px;"/>
<!--                                                <field name="entrance2_base_number"/>-->
                                                <field name="entrance2_location_number" style="width:100px;"/>
                                                <field name="entrance2_pack_barcode" style="width:100px;"/>
                                            </group>
                                            >
                                        </group>
                                    </group>
                                </group>
                            </form>
                        </page>
<!--                        <page string="记录">-->
<!--                            <form>-->

<!--                            </form>-->
<!--                        </page>-->
                        <page string="操作日志">
<!--                                <button name="clear_logs" type="object" string="Clear Logs" class="btn-secondary mt8"/>-->
<!--                                <field name="log_messages" widget="ace" options="{'mode': 'text'}" placeholder="Operation logs will appear here..." style="min-height: 300px;"/>-->
<!--                                <div style="display: flex; flex-direction: row; gap: 10px;">-->
<!--                                    <div style="flex: 1;">-->
<!--                                        <field name="log_messages" widget="ace" options="{'mode': 'text'}"-->
<!--                                               placeholder="Operation logs will appear here..." style="min-height: 300px;"/>-->
<!--                                    </div>-->
<!--                                    <div style="flex: 1;">-->
<!--                                        <field name="log_messages" widget="ace" options="{'mode': 'text'}"-->
<!--                                               placeholder="Operation logs will appear here..." style="min-height: 300px;"/>-->
<!--                                    </div>-->
<!--                                </div>-->
                                <div style="display: flex; flex-direction: column; gap: 10px;">
                                    <div style="display: flex; flex-direction: row; gap: 10px;">
                                        <div style="flex: 1;">
                                            <label for="first_30_logs" string="前30条日志记录"/>
                                            <field name="first_30_logs" widget="ace" options="{'mode': 'text'}"
                                                   placeholder="First 30 operation logs will appear here..." style="min-height: 300px;"/>
                                        </div>
                                        <div style="flex: 1;">
                                            <label for="last_30_logs" string="后30条日志记录"/>
                                            <field name="last_30_logs" widget="ace" options="{'mode': 'text'}"
                                                   placeholder="Last 30 operation logs will appear here..." style="min-height: 300px;"/>
                                        </div>
                                    </div>
<!--                                    <div>-->
<!--                                        <label for="log_messages" string="完整日志记录"/>-->
<!--                                        <field name="log_messages" widget="ace" options="{'mode': 'text'}"-->
<!--                                               placeholder="All operation logs will appear here..." style="min-height: 200px;"/>-->
<!--                                    </div>-->
                                </div>
                        </page>
                    </notebook>
                </sheet>
            </form>

        </field>
    </record>


    <record id="warehouse_system_operate_act_window" model="ir.actions.act_window">
        <field name="name">立库操作</field>
        <field name="res_model">warehouse.system.operate</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
