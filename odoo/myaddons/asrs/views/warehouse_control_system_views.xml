<odoo>

    <record id="warehouse_control_system_view_list" model="ir.ui.view">
        <field name="name">warehouse_control_system_view_list</field>
        <field name="model">warehouse.control.system</field>
        <field name="arch" type="xml">
            <list>
<!--                <field name="life"/>-->
<!--                <field name="ready"/>-->
                <field name="factory"/>
                <field name="workshop"/>
                <field name="line"/>
                <field name="machine"/>
            </list>
        </field>
    </record>

    <record id="warehouse_control_system_view_form" model="ir.ui.view">
        <field name="name">warehouse_control_system_view_form</field>
        <field name="model">warehouse.control.system</field>
        <field name="arch" type="xml">

            <form string="自控系统">
                <header>
                    <button name="control_system_read_write" type="object" string="读取状态"/>
                    <button name="setup_auto_refresh" string="Start Auto Refresh" type="object"/>

<!--                    <field name="status" widget="statusbar"/>-->
                </header>
                <sheet>
<!--                    <group>-->
<!--                        <group>-->
<!--                            <field name="factory"/>-->
<!--                        </group>-->

<!--                    </group>-->
                    <group>
                        <group>
                            <group>
                                <field name="factory" readonly="True"/>
                                <field name="workshop" readonly="True"/>
                                <field name="line" readonly="True"/>
                                <field name="machine" readonly="True"/>
                            </group>
                            <group>
                                <field name="netcontrol"  readonly="True"/>
                                <field name="pccontrol" readonly="True"/>
                                <field name="alarm" readonly="True"/>
                                <field name="ready" readonly="True"/>
                            </group>
                        </group>
                        <group>
                           <group>
                                <field name="hardware_ready" readonly="True"/>
                                <field name="auto_ready" readonly="True"/>
                                <field name="auto_finish" readonly="True"/>
                                <field name="auto_state" readonly="True"/>
                            </group>
                            <group>
                                <field name="auto_source_position"  readonly="True"/>
                                <field name="auto_target_position" readonly="True"/>
                                <field name="auto_take_finish" readonly="True"/>
                                <field name="auto_feed_finish" readonly="True"/>
                            </group>
                        </group>
                    </group>
                    <notebook>
                        <page string="当前状态">
                            <group>
                            <field name="factory"/>
                            </group>
                        </page>
                        <page string="堆高机">
                            <group>
                            <field name="factory"/>
                            </group>
                        </page>
                        <page string="输入状态">

                            <field name="input_ids" nolabel="1">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="address"/>
                                    <field name="name"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                        <page string="输出状态">

                            <field name="output_ids" nolabel="1">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="address"/>
                                    <field name="name"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>

        </field>
    </record>

    <record id="warehouse_control_system_act_window" model="ir.actions.act_window">
        <field name="name">自控系统</field>
        <field name="res_model">warehouse.control.system</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
