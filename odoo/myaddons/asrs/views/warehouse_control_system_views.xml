<odoo>

    <record id="warehouse_control_system_view_list" model="ir.ui.view">
        <field name="name">warehouse_control_system_view_list</field>
        <field name="model">warehouse.control.system</field>
        <field name="arch" type="xml">
            <list>
<!--                <field name="life"/>-->
<!--                <field name="ready"/>-->
                <field name="factory"/>
                <field name="workshop"/>
                <field name="line"/>
                <field name="machine"/>
            </list>
        </field>
    </record>

    <record id="warehouse_control_system_view_form" model="ir.ui.view">
        <field name="name">warehouse_control_system_view_form</field>
        <field name="model">warehouse.control.system</field>
        <field name="arch" type="xml">

            <form js_class="warehouse_form">
                <header>
                    <button name="control_system_read_write" type="object" string="读取状态"/>
                    <button name="start_scheduler" string="Start scheduler" type="object"/>
                    <button name="stop_scheduler" string="Stop scheduler" type="object"/>
<!--                    <field name="status" widget="statusbar"/>-->
                </header>
                <sheet>
<!--                    <group>-->
<!--                        <group>-->
<!--                            <field name="factory"/>-->
<!--                        </group>-->

<!--                    </group>-->
                    <group>
                        <group>
                            <group>
                                <field name="factory" readonly="True"/>
                                <field name="workshop" readonly="True"/>
                                <field name="line" readonly="True"/>
                                <field name="machine" readonly="True"/>
                            </group>
                            <group>
                                <field name="netcontrol"  readonly="True"/>
                                <field name="netdata" readonly="True"/>
                                <field name="system_alarm" readonly="True"/>
                                <field name="hardware_ready" readonly="True"/>

                            </group>
                        </group>
                        <group>
                           <group>
                                <field name="system_ready" readonly="True"/>
                                <field name="auto_ready" readonly="True"/>
                               <field name="task_running" readonly="True"/>
                                <field name="auto_finish" readonly="True"/>

                            </group>
                            <group>
                                <field name="auto_source_position"  readonly="True"/>
                                <field name="auto_target_position" readonly="True"/>
                                <field name="auto_take_finish" readonly="True"/>
                                <field name="auto_feed_finish" readonly="True"/>
                            </group>
                        </group>
                    </group>
                    <notebook>
                        <page string="当前状态">
                            <group>
                            <field name="factory"/>
                            </group>
                        </page>
                        <page string="堆高机">
                            <group>
                            <field name="factory"/>
                            </group>
                        </page>
<!--                        <page string="输入状态">-->

<!--                            <field name="input_ids" nolabel="1">-->
<!--                                <list editable="bottom" create="false" delete="false">-->
<!--                                    <field name="address"/>-->
<!--                                    <field name="name"/>-->
<!--                                    <field name="value"/>-->
<!--                                </list>-->
<!--                            </field>-->
<!--                        </page>-->
<!--                        <page string="输出状态">-->

<!--                            <field name="output_ids" nolabel="1">-->
<!--                                <list editable="bottom" create="false" delete="false">-->
<!--                                    <field name="address"/>-->
<!--                                    <field name="name"/>-->
<!--                                    <field name="value"/>-->
<!--                                </list>-->
<!--                            </field>-->
<!--                        </page>-->
                        <page string="操作日志">
<!--                                <button name="clear_logs" type="object" string="Clear Logs" class="btn-secondary mt8"/>-->
<!--                                <field name="log_messages" widget="ace" options="{'mode': 'text'}" placeholder="Operation logs will appear here..." style="min-height: 300px;"/>-->
<!--                                <div style="display: flex; flex-direction: row; gap: 10px;">-->
<!--                                    <div style="flex: 1;">-->
<!--                                        <field name="log_messages" widget="ace" options="{'mode': 'text'}"-->
<!--                                               placeholder="Operation logs will appear here..." style="min-height: 300px;"/>-->
<!--                                    </div>-->
<!--                                    <div style="flex: 1;">-->
<!--                                        <field name="log_messages" widget="ace" options="{'mode': 'text'}"-->
<!--                                               placeholder="Operation logs will appear here..." style="min-height: 300px;"/>-->
<!--                                    </div>-->
<!--                                </div>-->
                                <div style="display: flex; flex-direction: column; gap: 10px;">
                                    <div style="display: flex; flex-direction: row; gap: 10px;">
                                        <div style="flex: 1;">
                                            <label for="first_30_logs" string="前30条日志记录"/>
                                            <field name="first_30_logs" widget="ace" options="{'mode': 'text'}"
                                                   placeholder="First 30 operation logs will appear here..." style="min-height: 300px;"/>
                                        </div>
                                        <div style="flex: 1;">
                                            <label for="last_30_logs" string="后30条日志记录"/>
                                            <field name="last_30_logs" widget="ace" options="{'mode': 'text'}"
                                                   placeholder="Last 30 operation logs will appear here..." style="min-height: 300px;"/>
                                        </div>
                                    </div>
<!--                                    <div>-->
<!--                                        <label for="log_messages" string="完整日志记录"/>-->
<!--                                        <field name="log_messages" widget="ace" options="{'mode': 'text'}"-->
<!--                                               placeholder="All operation logs will appear here..." style="min-height: 200px;"/>-->
<!--                                    </div>-->
                                </div>
                        </page>
                    </notebook>
                </sheet>
            </form>

        </field>
    </record>

    <record id="warehouse_control_system_act_window" model="ir.actions.act_window">
        <field name="name">自控系统</field>
        <field name="res_model">warehouse.control.system</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
