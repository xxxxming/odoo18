<odoo>

    <record id="warehouse_location_information_view_list" model="ir.ui.view">
        <field name="name">warehouse_location_information_view_list</field>
        <field name="model">warehouse.location.information</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="create_location_record" type="object" string="创建库位" class="btn-info" display="always"/>
                    <button name="batch_create_location_records" type="object" string="批量创建" class="btn-info" display="always"/>
                </header>

                <field name="goods_status"/>
                <field name="goods_cancel"/>
                <field name="fixed_pack_number"/>
                <field name="fixed_pack_barcode"/>
                <field name="base_number"/>
                <field name="location_number"/>
                <field name="pack_number"/>
                <field name="pack_barcode"/>
<!--                <control>-->
<!--                    <create string="Add an item"/>-->
<!--                    <create string="Add a section" context="{'default_type': 'section'}"/>-->
<!--                    <create string="Add a note" context="{'default_type': 'note'}"/>-->
<!--                </control>-->
            </list>
        </field>
    </record>

    <record id="warehouse_location_information_view_kanban" model="ir.ui.view">
        <field name="name">warehouse_location_information_view_kanban</field>
        <field name="model">warehouse.location.information</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_box">
                <templates>
                    <t t-name="kanban-box">
                        <div>

                                <div style="position: absolute; top: 8px; right: 10px;">
                                    序号：<field name="base_number"/>

                                </div>

                                <!-- 主体内容 -->
                                <div>
                                    <p style="background-color: #d4edda;">库位：<field name="location_number"/></p>
                                    <p>框号：<field name="pack_number" style="margin-right: 40px;"/> 有货：<field name="goods_status"/></p>
                                    <p>框码：<field name="pack_barcode"/></p>

<!--                                    <button type="object" name="action_view_details" string="查看详情" class="btn btn-primary btn-sm"/>-->
<!--                                    <span t-if="!record.goods_status.raw_value" class="badge text-bg-success" title="正常">正常</span>-->
<!--                                    <span t-else="" class="badge text-bg-danger" title="已取消">已取消</span>-->
<!--                                    <xpath expr="//field[@name='goods_status']" position="replace">-->
<!--                                        <span t-attf-class="badge {{ 'bg-success' if record.goods_status else 'bg-secondary' }}"-->
<!--                                              t-att-title="'有货' if record.goods_status else '无货'"-->
<!--                                              t-out="'有货' if record.goods_status else '无货'"/>-->
<!--                                    </xpath>-->
                                </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="warehouse_location_information_act_window" model="ir.actions.act_window">
        <field name="name">库位信息</field>
        <field name="res_model">warehouse.location.information</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>

