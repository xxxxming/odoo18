<!--常用图标说明-->
<!--以下是一些常用的Font Awesome图标，你可以在kanban视图中使用：-->
<!--fa fa-circle - 圆点指示器（常用于状态指示）-->
<!--fa fa-check - 对勾（表示完成或正常）-->
<!--fa fa-times - 叉号（表示错误或取消）-->
<!--fa fa-exclamation-triangle - 警告三角形（表示警告）-->
<!--fa fa-info-circle - 信息图标-->
<!--fa fa-map-marker - 位置标记-->
<!--fa fa-archive - 档案/框号-->
<!--fa fa-barcode - 条码-->
<!--fa fa-tag - 标签-->
<!--fa fa-clock-o - 时钟（表示时间）-->

