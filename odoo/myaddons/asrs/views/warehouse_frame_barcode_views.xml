<odoo>

    <record id="warehouse_frame_barcode_view_list" model="ir.ui.view">
        <field name="name">warehouse_frame_barcode_view_list</field>
        <field name="model">warehouse.frame.barcode</field>
        <field name="arch" type="xml">
            <list>
                <header>
<!--                    <button name="create" type="object" string="创建" display="always"/>-->
                    <button name="create_new_record" type="object" string="创建新框" class="btn-info" display="always"/>
                    <button name="batch_create_records" type="object" string="批量创建" class="btn-info" display="always"/>
                </header>
                <field name="serial_number"/>
                <field name="frame_number"/>
                <field name="frame_barcode"/>
<!--                <field name="total_locations"/>-->
                <control>
                    <create string="Add an item"/>
                    <create string="Add a section" context="{'default_type': 'section'}"/>
                    <create string="Add a note" context="{'default_type': 'note'}"/>
                </control>
            </list>
        </field>
    </record>

<!--<button name="increment_number" type="object" string="按钮"/>-->

    <record id="warehouse_frame_barcode_view_kanban" model="ir.ui.view">
        <field name="name">frame_barcode_view_kanban</field>
        <field name="model">warehouse.frame.barcode</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_box" >
                <templates>
                    <t t-name="kanban-box">
                        <div>
                            <p>
                               序号： <field name="serial_number"/>
                            </p>
                            <p>
                               框号： <field name="frame_number" />
                            </p>
                            <p>
                               条码： <field name="frame_barcode" />
                            </p>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="warehouse_frame_barcode_act_window" model="ir.actions.act_window">
        <field name="name">框码定义</field>
        <field name="res_model">warehouse.frame.barcode</field>
        <field name="view_mode">kanban,list</field>
    </record>

</odoo>

